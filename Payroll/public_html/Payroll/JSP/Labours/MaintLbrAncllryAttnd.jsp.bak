    <!-- Bottom Blue Bar-->
   <TR>
      <td align=center bgcolor=#4682b4 width="40%"></td>
      <td bgColor=#4682b4></td>
      <td align=right bgColor=#4682b4><img src="../INCLUDES/IMAGES/man.jpg"></td>
   </TR>
    <TR>
	<td background="../INCLUDES/IMAGES/line_t.gif" width="100%" style="color:#FF3300;font-size:10pt;text-align:left;font-weight:normal;font-family:'verdana, Arial, Helvetica, sans-serif'">
	<%
						if(empLbr != null)
						{
						if (empLbr.equals("D")) 
							{
					%>
                         No.of Present Days = ( W + P + K + H + S + M  + L + F(0.5) )
					<%       } 
					else 
						{%>
						 No.of Present Days = ( W + K + H + S + M + B + F(0.5)) 
					<% }} %> 
	</td>
  </TR>
    
  </TABLE>
 
<!-- Container Table Ending Columns Starts-->
  </TD>    
</TR>
</TBODY>
</TABLE>

