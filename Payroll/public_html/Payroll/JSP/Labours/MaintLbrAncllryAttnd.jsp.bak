                   alert("Amount To Should Be Greater Than Amount From");
                   document.getElementsByName("endField")[i].focus(); 
                   return false;
                }                             

            }             
 
        return true;
}

function checkAttndType()
{
    if(document.all.hdnEmpLbrFlag.value=='D')
	{
		var keyArr=[65,68,70,72,75,77,80,83,87,97,100,102,104,107,109,112,115,119,76,108];  // 68,100 omitted by dushyant on 19-may-2011 for DPS
	}
	else
	{
		var keyArr=[66,68,72,75,87,98,100,104,107,119];  //A,B,C,D,F,H,I,K,M,S,W 67 ,99,73,105 added by dushyant on 19-may-2011  C,I added
	}
    var i;
    var flag='false';
    for(i=0; i<keyArr.length+1; i++)
    {
        if (event.keyCode == keyArr[i])
        {
            flag='true';
            break;
        }
    }    
    if (flag=='true')
        return true;
    else 
        return false;    
}
 
function upper(val)
{
    val.value=val.value=='' ? 'W' : val.value.toUpperCase();   
}

function calcPresentOnLoad(val)
{
    var presentDays=0;
    var i=0;
    for(i=1;i<=31;i++)
    {
      varField="txtDays"+i;
      var pres=document.getElementsByName(varField)[val-1].value;
      if(pres=='W' || pres=='P' ||  pres=='K'  ||  pres=='H' || pres=='B' || pres=='S'|| pres=='M'|| pres=='w' || pres=='p' || pres=='k' || pres=='h' || pres=='b'|| pres=='s'|| pres=='m')
        presentDays=presentDays+1;
      if(pres=='F' || pres=='f' )  
        presentDays = parseFloat(presentDays+0.5);

      if(pres=='A' || pres=='a' )  
      {
        document.getElementsByName(varField)[val-1].style.background="#FF3300";        
      }
      if(pres=='M' || pres=='m' )  
        document.getElementsByName(varField)[val-1].style.background="#FFCC00";  
      if(pres=='P' || pres=='p' )  
        document.getElementsByName(varField)[val-1].style.background="#33CCFF";  
      if(pres=='W' || pres=='w' )  
        document.getElementsByName(varField)[val-1].style.background="#CCFF00";    
      if(pres=='H' || pres=='h' )  
        document.getElementsByName(varField)[val-1].style.background="#CC9900";  
      if(pres=='F' || pres=='f' )  
        document.getElementsByName(varField)[val-1].style.background="#FFFF00";  
      if(pres=='K' || pres=='k' )  
        document.getElementsByName(varField)[val-1].style.background="#66CC00";  
      if(pres=='S' || pres=='s' )  
        document.getElementsByName(varField)[val-1].style.background="#CC99FF";  
      if(pres=='D' || pres=='d' )  
        document.getElementsByName(varField)[val-1].style.background="#FFCCFF";
	  if(pres=='B' || pres=='b' )  
        document.getElementsByName(varField)[val-1].style.background="#3399FF";  // added by dushyant on 02-may-2011 for dept labour
	  if(pres=='C' || pres=='c' )
	 	document.getElementsByName(varField)[val-1].style.background="#55DDFF";  // added by swapnendu Dt 14 Sep 2012.
	  if(pres=='I' || pres=='i' )
		document.getElementsByName(varField)[val-1].style.background="#FF7777";  // added by swapnendu Dt 14 Sep 2012.
    }
    document.getElementsByName("txtSrlNo")[val-1].value=presentDays;
}

function calcPresent(val)
{
    var presentDays=0;
    var i=0;
    for(i=1;i<=31;i++)
    {
      varField="txtDays"+i;
      var pres=document.getElementsByName(varField)[val-1].value;
      if(pres=='W' || pres=='w' || pres=='P' || pres=='p' ||  pres=='K'  || pres=='k' || pres=='H' || pres=='h' ||
		  pres=='B' || pres=='b'|| pres=='S'||  pres=='s'|| pres=='M'|| pres=='m' || pres=='C' || pres=='c')
        presentDays=presentDays+1;
      if(pres=='F' || pres=='f' )  
        presentDays = parseFloat(presentDays+0.5);
      
      if(pres=='A' || pres=='a' )  
      {
        document.getElementsByName(varField)[val-1].style.background="#FF3300";
        if(frmLbrAncllryAttndForm.hdnEmpLbrFlag.value == 'D')
          setWeekOff(val,i);
      }
      if(pres=='M' || pres=='m' )  
        document.getElementsByName(varField)[val-1].style.background="#FFCC00";  
      if(pres=='P' || pres=='p' )  
        document.getElementsByName(varField)[val-1].style.background="#33CCFF";  
      if(pres=='W' || pres=='w' )  
        document.getElementsByName(varField)[val-1].style.background="#CCFF00";    
      if(pres=='H' || pres=='h' )  
        document.getElementsByName(varField)[val-1].style.background="#CC9900";  
      if(pres=='F' || pres=='f' )  
        document.getElementsByName(varField)[val-1].style.background="#FFFF00";  
      if(pres=='K' || pres=='k' )  
        document.getElementsByName(varField)[val-1].style.background="#66CC00";  
      if(pres=='S' || pres=='s' )  
        document.getElementsByName(varField)[val-1].style.background="#CC99FF";  
      if(pres=='D' || pres=='d' )  
        document.getElementsByName(varField)[val-1].style.background="#FFCCFF";
	  if(pres=='B' || pres=='b' )  
        document.getElementsByName(varField)[val-1].style.background="#3399FF";  // added by dushyant on 02-may-2011 for dept labour
      if(pres=='C' || pres=='c')  
		document.getElementsByName(varField)[val-1].style.background="#55DDFF"; //added by swapnendu Dt 14 Sep 2012.
	  if(pres=='I' || pres=='i')
		document.getElementsByName(varField)[val-1].style.background="#FF7777"; //added by swapnendu Dt 14 Sep 2012.
    }    
    document.getElementsByName("txtSrlNo")[val-1].value=presentDays;
}

function setWeekOff(indx, dayNo)
{
  var  yearM = document.getElementById("txtYYMM").value;          
  var month =  yearM.substring(4,6); 
  var firstDay = getDayofWeek(month, yearM.substring(0,4),dayNo);  
  var noDays = daysYearMonth(month, yearM.substring(0,4)); //added by nand on 05-mar-2013
  if(firstDay == 0)
  {
    return;
  }
  else  
  {
    while(firstDay < 6)
    {
      firstDay++;
      dayNo++;
    }
    dayNo=dayNo+1;
    varField="txtDays"+dayNo; 

	if(dayNo <= 31  && dayNo <= noDays) //modified by swapnendu Dt 02 Oct 2011, changes also done by nand on 05-mar-2013
	{
		if(document.getElementsByName(varField)[indx-1].value=='K' || document.getElementsByName(varField)[indx-1].value=='k' ) 
		{
			document.getElementsByName(varField)[indx-1].value ='K';
			document.getElementsByName(varField)[indx-1].style.background="#66CC00";
		}
		else
		{
			document.getElementsByName(varField)[indx-1].style.background="#FF3300";
			document.getElementsByName(varField)[indx-1].value ='A';
		}
	}
  } 
}

 function disableleavedays()
{
var fieldVal="";
var currval
 var oTable = document.getElementById("Detail");
	var iTr2 = oTable.rows.length;
    if (oTable == null)
    {
      return;
    }
	else
	{
		
		for(i=0; i < iTr2 -2; i++)
		{   
			for(j=1; j < 32; j++)    
			
			
			
			{ 
			
