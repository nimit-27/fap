                                <logic:notEqual name="darate" property="status" value="D" >                                                        
                            <tr><% ++j; %>                              
                              <td width = 1%></TD>
                    <!-- added by dushyant on 18-Jan-2012-->
					           <td ><html:text property="txtSrNo" name="frmLbrAncllryAttndForm" size="3"   value="<%=String.valueOf(i)%>" styleClass="locked" style="width:100%" alt="<%=String.valueOf(i)%>"  /></td>
					 <!-- added by dushyant on 18-Jan-2012-->
                    <!-- added by dushyant on 22-feb-2011-->
							  <td  width="2%" ><html:text property="txtEmpNo" name="darate" styleClass="locked" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" readonly="true" maxlength="9" onchange="" /></td> 
                    <!-- added by dushyant on 22-feb-2011-->

                              <td  width="12%" ><html:text property="txtEmpName" name="darate" styleClass="locked" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" readonly="true" maxlength="9" onchange="" /></td>                                                         
                              
                              <% if(empLbr.equals(new String("K"))) {%> 
                              <td width = 2% ><html:text property="txtLabourCode" name="darate" styleClass="locked" readonly="true" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" maxlength="9" onchange="" /></td>                         
                              <%} else {  %>           
                              <td><html:hidden  property="txtLabourCode" altKey="Payroll.Labour.LabourCode"  /></td>  
                              <%}  %>
                              
                              <td width = 1%>
                              <html:text property="txtDays1" name="darate" alt="<%=String.valueOf(i)%>" style="width:100%;text-align:center" maxlength="1" onclick="this.value='';" onblur="upper(this);" onkeypress="return checkAttndType();" onchange="calcPresent(this.alt); lfnChange('1', this.alt);" />
                              </TD>
                             
