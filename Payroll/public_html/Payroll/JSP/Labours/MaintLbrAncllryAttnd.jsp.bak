                            <TD id="<%=m+1 %>" class=tableHeader width="2%"><%=m+1 %></TD>                            
                            <% }
                            %>
                            <TD class=tableHeader width="2%">No of Present Days</td>
                            </TR>            
                            
                          <logic:iterate id="darate" name="frmLbrAncllryAttndForm" property="lstInstrDtls" type="FCIPAY.Payroll.Labour.Utility.LbrAncllryAttndBean" >
