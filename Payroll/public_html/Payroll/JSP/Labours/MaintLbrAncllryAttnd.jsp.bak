<%@ taglib uri="/WEB-INF/struts-html.tld" prefix="html" %>
<%@ taglib uri="/WEB-INF/struts-logic.tld" prefix="logic" %>
<%@ taglib uri="/WEB-INF/struts-bean.tld" prefix="bean" %>

<html:html>
	<HEAD>
  <html:base/>
		<TITLE><bean:message key="Payroll.title" /></TITLE>
    <jsp:include page = "../INCLUDES/GenIncludes.jsp" />
    
    <link rel="STYLESHEET" type="text/css" href="../../CSS/PayrollMenucss.css">
    <script language="JavaScript1.2" src="../../../COMMON/JavaScript/Menu_func.js"></script>
    <script language="JavaScript1.2" src="../../../COMMON/JavaScript/validate.js"></script>
    <script language="JavaScript1.2" src="../../../COMMON/JavaScript/Menu_addins.js"></script>
    <script language="JavaScript1.2" src="../INCLUDES/payrollToolBar.js"></script>
</head>
<BODY  onload="lfnLoad();history.forward(1);" onbeforeunload="confWindowClose()" onunload="handleOnClose()" oncontextmenu="return false" >
<jsp:include page="../../../COMMON/JSP/menu.jsp" flush="true" />



<html:form  action="LbrAncllryAttndDetailBase" name="frmLbrAncllryAttndForm" type="FCIPAY.Payroll.Labour.WEBTIER.Form.MaintAncllryAttndForm" scope="session">
<bean:define id="ParentForm" name="frmLbrAncllryAttndForm" toScope="request" />
<jsp:include page = "../INCLUDES/GenIconMenu.jsp" />

<html:hidden property="detailDataChanged"  />
<html:hidden property="headerFields" value="false" />
<%! int i=0,j=0; %>
<% i = 0;j=0; %>
<%
	String empLbr = (String)(request.getSession().getAttribute("hdnEmpLbrFlag"));
%>
<html:errors/>
<table>
<TR height=30>
  <TD  colSpan=12 class=mainHeader height=10>MAINTAIN ANCILLARY LABOUR ATTENDANCE</TD>
</TR>
</TABLE>
<!--container table starts -->
<TABLE cellSpacing=0 cellPadding=0 border=0 >
<TBODY>
  <TR>
    <TD>
	
       <!--<div id=divBody>-->
       <!-- Body table Starts -->
       <TABLE cellSpacing=0 cellPadding=0 border=0>
       <!--Account  Header Row Starts -->
       <TR>
          <TD class=subHeader colspan=6>Attendance Header</TD>
        </TR>
        <TR>
              <TD colspan=6 bgColor=#4682b4><IMG height=1 src="../INCLUDES/IMAGES/pixel.gif" width=1 border=0></TD>
	      </TR>
         <tr height="15" >
            <td colspan="2"></td>
         </tr>
          <tr>
        
            <html:hidden property="lstLabourType" />
            
            <td width="25%" class=labelText  ><bean:message key="Payroll.Labour.Loc" /> </td>
            <td width="25%">                  
            <logic:equal property= "screenMode" name= "frmLbrAncllryAttndForm" value="U">                              
            <html:text  property="txtLocation" maxlength="20" size="23" titleKey="Payroll.Labour.Loc" styleClass="required" readonly="true"/>                  
            </logic:equal>                                                                                                 
            <logic:notEqual property= "screenMode" name= "frmLbrAncllryAttndForm" value="U">                              
            <html:text  property="txtLocation" maxlength="20" size="23" titleKey="Payroll.Labour.Loc" styleClass="required" readonly="true" onchange="" />                  
            <img src="../INCLUDES/IMAGES/lov.jpg" height="16" align="center" name="buttxtSection" onclick="return ShowLovLocation();" readonly="true">
            </logic:notEqual><html:hidden  property="txtLocId" altKey="Payroll.Labour.GangId"  />
            </td>
            
            <td class="labelText"  width="25%" ><bean:message key="Payroll.MaintDARates.year" /></td>
            <td>
            <logic:notEqual property= "screenMode" name= "frmLbrAncllryAttndForm" value="U">                              
            <html:text  property="txtYYMM" altKey="Payroll.MaintDARates.year" maxlength="6" size="23" titleKey="Payroll.MaintDARates.year" styleClass="required" onchange="chk_YearMonth(); " />
            <bean:message key="Payroll.MaintDARates.yymm" />
            </logic:notEqual>   
            <logic:equal property= "screenMode" name= "frmLbrAncllryAttndForm" value="U">                              
            <html:text  property="txtYYMM" altKey="Payroll.MaintDARates.year" maxlength="6" size="23" styleClass="required" readonly="true" onchange="chk_YearMonth();" />
            <bean:message key="Payroll.MaintDARates.yymm" />
            </logic:equal>   
            </td>
          </tr>
          <tr height="10">		    
        <TD colspan="2" > </TD>
      </tr>
    </table>
  </div>
  
  <table cellspacing=0 cellpadding=0 border=0>
         <!-- Detail Information Row starts -->

 	 <TR height="200">
            <TD colspan=11>

            <!-- Account Config Detail Table Starts -->
           <TABLE cellspacing="0" cellPadding="0" >
              <TR>
                    <td bgcolor="#4682B4" width="10"><img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></td>
                    <td bgcolor="#4682B4" nowrap class=actTabText > Attendance Details <img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></td>
                    <td><img src="../INCLUDES/IMAGES/formtab_r.gif" width="10" height="21" border="0"></td>
                    
                   <td background="../INCLUDES/IMAGES/line_t.gif" width="100%" style="color:#993300;font-size:8pt;text-align:right;font-weight:normal;font-family:'verdana, Arial, Helvetica, sans-serif'">
					<%
						if(empLbr != null)
						{
						if (empLbr.equals("D")) 
							{
					%>
						A-Absent&nbsp;&nbsp;F-Half Day Leave&nbsp;&nbsp;M-Medical Leave&nbsp;&nbsp;P-Present&nbsp;&nbsp;W-On Work&nbsp;&nbsp;H-Holiday&nbsp;&nbsp;K-Work on Holiday&nbsp;&nbsp;S-Pre Sanction Leave&nbsp;&nbsp;D-Present On Holiday But No Work&nbsp;L-Leave Without Pay&nbsp;
					<%       } 
					else 
						{%>
						A-Absent<font style="color:#2C2C2C;font-size:10pt">|</font>F-Half Pay Leave<font style="color:#2C2C2C;font-size:10pt">|</font>M-Med Leave<font style="color:#2C2C2C;font-size:10pt">|</font>W-On Work<font style="color:#2C2C2C;font-size:10pt">|</font>H-Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>K-Work on Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>D-Attend Day<font style="color:#2C2C2C;font-size:10pt">|</font>V-Privilege Leave<font style="color:#2C2C2C;font-size:10pt">|</font>B-Booked On NonPaid Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>C-Casual Leave<font style="color:#2C2C2C;font-size:10pt">|</font>|I-Disability Leave|T-Maternity Leave 
					<% }} %> 
					</td>
                    <td background="../INCLUDES/IMAGES/line_t.gif"><img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></td>
              </TR>
          
              <TR height=10>
                
		<!-- Detail table Container starts -->
                <TD colspan="8">
                  <TABLE cellSpacing="0" cellPadding="0" border="0" >
                    <TBODY>
                    <TR>
                      <TD >
