				currval=document.getElementsByName(fieldVal)[i].value;      
			
			 if(currval=='A' || currval=='C' || currval=='F' || currval=='I' || currval=='V' || currval=='T' || currval=='M') 
{			 
			
				document.getElementsByName(fieldVal)[i].disabled = "true";
			
				
}
		
				}
		}
	}

}

 
function enableAllFields(){

var f = document.getElementsByTagName('input');

for(var i=0;i<f.length;i++){
if(f[i].getAttribute('type')=='text'){
f[i].setAttribute('disabled',false);
}
}
}
//Added by Nand on 25 feb 2014 for LWP (CR 358)
function setWeekOffLWP(indx, dayNo)
{
  var  yearM = document.getElementById("txtYYMM").value;          
  var month =  yearM.substring(4,6); 
  var firstDay = getDayofWeek(month, yearM.substring(0,4),dayNo); 
  var noDays = daysYearMonth(month, yearM.substring(0,4));
  if(firstDay == 0)
  {
    return;
  }
  else  
  {
    while(firstDay < 6)
    {
      firstDay++;
      dayNo++;
    }
    dayNo=dayNo+1;
    varField="txtDays"+dayNo; 
    if(dayNo <= 31 && dayNo <= noDays) 
	{
		if(document.getElementsByName(varField)[indx-1].value=='L' || document.getElementsByName(varField)[indx-1].value=='l' ) 
		{
			if(document.getElementsByName(varField)[indx-1].value=='A' || document.getElementsByName(varField)[indx-1].value=='a' ) 
			{
				document.getElementsByName(varField)[indx-1].value = 'A';
				document.getElementsByName(varField)[indx-1].style.background="#FF3300";
			}
		}
	}
  } 
}

</script> 