  			<!-- Detail table starts -->
                        <TABLE cellSpacing="0" cellPadding="0" id="Detail" border=0>
                          <TBODY>
                          <tr width="100%">                            
                            <TD width="100%" colspan="35" class=tableHeader width="2%"><bean:message  key="Payroll.Labour.Days" /></TD></tr>
                          <TR>
                            <td class=tableHeader width = 1%></TD>
							<td class=tableHeader width="1%"><bean:message key="Payroll.MaintDirect.srno" /></td><!-- added by dushaynt on 18-Jan-2012-->
							<TD class=tableHeader width="1%"><bean:message  key="Payroll.Common.empNo" /></td> <!-- added by dushaynt on 22feb2011-->
                            <TD class=tableHeader width="13%"><bean:message  key="Payroll.Common.empName" /></td>
                            
                            <% 
                            if(empLbr.equals(new String("K"))) {%> 
                            <TD class=tableHeader width = 2%> Labour Code</td>
                            <%} else {  %>           
                            <TD class=tableHeader width = 2%></td> 
                            <%}  %>
                            
                             <% for (int m=0; m<31; m++)
