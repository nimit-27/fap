function AmtCheck()
{
        var oTable = document.getElementById("Detail");
        var iTR = oTable.rows.length;
        var flag =0;
        
        for(i=0;i<iTR-1;i++)
        {   
            var m = parseInt(document.getElementsByName("startField")[i].value);
            var n= parseInt(document.getElementsByName("endField")[i].value);               

            if (m >= n)
            {
               alert("Amount To Should Be Greater Than Amount From");
               document.getElementsByName("endField")[i].focus(); 
               return false;
            }                           

        }             

    return true;
}

function checkAttndType()
{
	if(document.all.hdnEmpLbrFlag.value=='N')
	{
		var keyArr=[65,68,70,72,75,77,80,83,87,88,97,100,102,104,107,109,112,115,119,120,76,108];  // 68,100 omitted by dushyant on 19-may-2011 for DPS
	}
	else
	{
		var keyArr=[66,68,72,75,87,98,100,104,107,119];  //A,B,C,D,F,H,I,K,M,S,W 67 ,99,73,105 added by dushyant on 19-may-2011  C,I added
	}
    var i;
    for(i=0;i<keyArr.length+1;i++)
    {
        if (event.keyCode == keyArr[i])
        {
            flag='true';
            return true;
        }
    }    
	return false;
}
 
function upper(indx, seq)
{
	var tempType = document.getElementById("txtTempAttenType").value;
	var dayObj = document.getElementsByName("txtDays"+seq)[indx-1];
	if (dayObj.value == '')
	{
		if (tempType != "H")
		{
			dayObj.value = 'W';
			dayObj.style.background = "#CCFF00";
			if(frmNWNPLbrHndlngAttndForm.hdnEmpLbrFlag.value == 'N')
			{
				if (tempType == "A" && document.getElementsByName("txtDays"+seq)[indx-1].value != "A")
				{
						toggleWeekOff(indx,seq);
				}
			}
		}
		else 
		{
			dayObj.value = 'H';
			dayObj.style.background = "#CC9900";
		}
	}
	else
	{
		dayObj.value = dayObj.value.toUpperCase();
	}
}

function calcPresentOnLoad(val)
{
    var presentDays=0;
    var i=0;
    for(i=1;i<=31;i++)
    {
		varField="txtDays"+i;
		var pres=document.getElementsByName(varField)[val-1].value;
		if(pres=='W' || pres=='P' ||  pres=='K' || pres=='B' || pres=='S'|| pres=='M'|| pres=='w' || pres=='p' || pres=='k' || pres=='b'|| pres=='s'|| pres=='m' || pres=='D' || pres=='d'|| pres=='C' || pres=='c'|| pres=='X' || pres=='x')
			presentDays=presentDays+1;
		if(pres=='F' || pres=='f' )
			presentDays = parseFloat(presentDays+0.5);
		if(pres=='A' || pres=='a' )
			document.getElementsByName(varField)[val-1].style.background="#FF3300";
		if(pres=='M' || pres=='m' )
			document.getElementsByName(varField)[val-1].style.background="#FFCC00";  
		if(pres=='P' || pres=='p' )
			document.getElementsByName(varField)[val-1].style.background="#33CCFF";  
		if(pres=='W' || pres=='w' )
			document.getElementsByName(varField)[val-1].style.background="#CCFF00";    
		if(pres=='H' || pres=='h' )
			document.getElementsByName(varField)[val-1].style.background="#CC9900";  
		if(pres=='F' || pres=='f' )
			document.getElementsByName(varField)[val-1].style.background="#FFFF00";  
		if(pres=='K' || pres=='k' )
			document.getElementsByName(varField)[val-1].style.background="#66CC00";  
		if(pres=='S' || pres=='s' )
			document.getElementsByName(varField)[val-1].style.background="#CC99FF";  
		if(pres=='D' || pres=='d' )
			document.getElementsByName(varField)[val-1].style.background="#FFCCFF";
		if(pres=='C' || pres=='c' )
			document.getElementsByName(varField)[val-1].style.background="#55DDFF";
		if(pres=='I' || pres=='i' )
			document.getElementsByName(varField)[val-1].style.background="#FF7777";
		if(pres=='B' || pres=='b')
			document.getElementsByName(varField)[val-1].style.background="#3399FF";
                if(pres=='X' || pres=='x')
			document.getElementsByName(varField)[val-1].style.background="#ffbf00";
    }
    document.getElementsByName("txtSrlNo")[val-1].value=presentDays;
}

function storeTempAttndType(val)
{
   if (val != "") document.getElementById("txtTempAttenType").value = val;
}

function calcPresent(indx,val, seq)
{
	document.getElementsByName("dayModified"+seq)[indx-1].value = "Y";
	
	var tempType = document.getElementById("txtTempAttenType").value;
	if (tempType == "H")
	{
	    if ((val == 'W' || val == 'w') || (val == 'P' || val == 'p') || (val == 'F' || val == 'f'))
		{
			alert("Wrong Type Entered  W ,P & F  Are  Not Allowed Inplace Of  H  ");
			document.getElementsByName("txtDays"+seq)[indx-1].value = tempType;
			return false;
		}
	}
	if (tempType == "A" && document.getElementsByName("txtDays"+seq)[indx-1].value != "A")
	{
		if(frmNWNPLbrHndlngAttndForm.hdnEmpLbrFlag.value == 'N')
			toggleWeekOff(indx,seq);
	}

    var presentDays=0;
    var i=0;    
    if(indx == 1)
    {
      if(val =='P' || val =='W' || val =='K' || val =='H' ||val =='D' || val =='B' || val =='p' || val =='w' || val =='k' || val =='h' ||val =='d' || val =='b')
        {
        //setAttndForAll(indx,val, seq); 
        }
    }
    for(i=1;i<=31;i++)
    {
		varField="txtDays"+i;        
		var pres=document.getElementsByName(varField)[indx-1].value;

		if(pres=='W' || pres=='P' ||  pres=='K' || pres=='B' || pres=='S' || pres=='M'|| pres=='w' || pres=='p' || pres=='k' || pres=='b'|| pres=='s'|| pres=='m' || pres=='D' || pres=='d' || pres=='C' || pres=='c' || pres=='X' || pres=='x')
		{
			presentDays = presentDays+1;
		}
		if(pres=='F' || pres=='f' )  
		{
			presentDays = parseFloat(presentDays+0.5);
		}
		if(pres=='A' || pres=='a' )  
		{
                    document.getElementsByName(varField)[indx-1].style.background="#FF3300";
                    if(frmNWNPLbrHndlngAttndForm.hdnEmpLbrFlag.value == 'N')
                    {
                           // setWeekOff(indx,i);
                    }
		}
		if(pres=='M' || pres=='m')  
			document.getElementsByName(varField)[indx-1].style.background="#FFCC00";  
		if(pres=='P' || pres=='p')  
			document.getElementsByName(varField)[indx-1].style.background="#33CCFF";  
		if(pres=='W' || pres=='w')  
			document.getElementsByName(varField)[indx-1].style.background="#CCFF00";    
		if(pres=='H' || pres=='h')  
			document.getElementsByName(varField)[indx-1].style.background="#CC9900";  
		if(pres=='F' || pres=='f')  
			document.getElementsByName(varField)[indx-1].style.background="#FFFF00";  
		if(pres=='K' || pres=='k')  
			document.getElementsByName(varField)[indx-1].style.background="#66CC00";  
		if(pres=='S' || pres=='s')  
			document.getElementsByName(varField)[indx-1].style.background="#CC99FF";  
		if(pres=='D' || pres=='d')  
			document.getElementsByName(varField)[indx-1].style.background="#FFCCFF";
		if(pres=='C' || pres=='c')  
			document.getElementsByName(varField)[indx-1].style.background="#55DDFF";
		if(pres=='I' || pres=='i')
			document.getElementsByName(varField)[indx-1].style.background="#FF7777";
		if(pres=='B' || pres=='b')  
			document.getElementsByName(varField)[indx-1].style.background="#3399FF";
                if(pres=='X' || pres=='x')
			document.getElementsByName(varField)[indx-1].style.background="#ffbf00";
    }
    document.getElementsByName("txtSrlNo")[indx-1].value=presentDays;
}

function setAttndForAll(indx,val, seq)
{
  var presDays=0;
  var sIdx;
  var oTable = document.getElementById("Detail");
  if(oTable == null)
  {
    return;
  }
  var iTr2 = oTable.rows.length;  
  var i = 0;
  varField="txtDays"+seq;
  
  if(val=='P' || val=='p' )  
    bgClr="#33CCFF";  
  if(val=='W' || val=='w' )  
    bgClr="#CCFF00";    
  if(val=='H' || val=='h' )  
    bgClr="#CC9900";
  if(val=='K' || val=='k' )  
    bgClr="#66CC00";    
  if(val=='D' || val=='d' )  
    bgClr="#FFCCFF";
  if(val=='B' || val=='b' )  
    bgClr="#3399FF";           // added by dushyant on 02-may-2011
//  if(val=='N' || val=='n' )  
//    bgClr="#FF6600";           // added by dushyant on 02-may-2011
  
  for(i=0; i < iTr2 -2; i++)
  {   
  var currval=document.getElementsByName(varField)[i].value;
  var emptype=document.all.hdnEmpLbrFlag.value;
  if (emptype=='L' )
  { 
    if(currval!='A' && currval!='C' && currval!='F' && currval!='I' && currval!='V' && currval!='T'&& currval!='M') 
    {
        document.getElementsByName(varField)[i].value = val.toUpperCase();
        document.getElementsByName(varField)[i].style.background =bgClr;
    }
  }else
  {
    document.getElementsByName(varField)[i].value = val.toUpperCase();
    document.getElementsByName(varField)[i].style.background =bgClr;
  }
    sIdx = i+1;
    lfnChange(val, sIdx);
	
    for(j=1;j<=31;j++)
    { 
      vField="txtDays"+j;        
      var sVal=document.getElementsByName(vField)[i].value;
      if(sVal=='W' || sVal=='P' ||  sVal=='K'  ||  sVal=='D' ||  sVal=='B' || sVal=='w' || sVal=='p' || sVal=='k' ||  sVal=='d' ||  sVal=='b')
        presDays=presDays+1;
      if(sVal=='F' || sVal=='f' )  
        presDays = parseFloat(presDays+0.5); 
    }    
    document.getElementsByName("txtSrlNo")[i].value=presDays;
    presDays =0;
  }
}

function setWeekOff(indx, dayNo)
{
  var  yearM = document.getElementById("txtYYMM").value;          
  var month =  yearM.substring(4,6); 
  var firstDay = getDayofWeek(month, yearM.substring(0,4),dayNo); 
  var noDays = daysYearMonth(month, yearM.substring(0,4));
  //alert("firstDay="+firstDay+"=dayNo="+dayNo+"=indx="+indx)

  if(firstDay == 0)
  {
    return;
  }
  else  
  {
    while(firstDay < 6)
    {
      firstDay++;
      dayNo++;
    }
    dayNo=dayNo+1;
    varField="txtDays"+dayNo; 
    if(dayNo <= 31 && dayNo <= noDays) //dayNo <= noDays condition added by swapnendu Dt 10 July 2012
	{
		if(document.getElementsByName(varField)[indx-1].value=='K' || document.getElementsByName(varField)[indx-1].value=='k' ) 
		{
			document.getElementsByName(varField)[indx-1].value = 'K';
			document.getElementsByName(varField)[indx-1].style.background="#66CC00";
		}
		else
		{
			document.getElementsByName(varField)[indx-1].style.background="#FF3300";
			document.getElementsByName(varField)[indx-1].value ='A';
		}
	}
  } 
}

function toggleWeekOff(indx, dayNo)
{
	var  yearM = document.getElementById("txtYYMM").value;          
	var month =  yearM.substring(4,6); 
	var firstDay = getDayofWeek(month, yearM.substring(0,4),dayNo); 
	var noDays = daysYearMonth(month, yearM.substring(0,4));
	if(firstDay == 0)
	{
		return;
	}
	else  
	{
		while(firstDay < 6)
		{
			firstDay++;
			dayNo++;
		}
		dayNo = dayNo+1;
		varField="txtDays"+dayNo;
		if(dayNo <= 31 && dayNo <= noDays)
		{
			document.getElementsByName(varField)[indx-1].style.background="#CC9900";
			document.getElementsByName(varField)[indx-1].value ='H';
		}
	}

}
//added by nitin on 28-02-2013
function checkYYMM(args)
{ 
	var payrollyymm = frmNWNPLbrHndlngAttndForm.payYYMM.value;
	if(args > payrollyymm)
	{
		alert("The payroll process is currently in "+payrollyymm+". So, attendance sheet for "+args+" cannot be filled.");
		document.getElementById("txtYYMM").value = "";
		document.getElementById("txtYYMM").focus(); 
		return false;
	}
	else
		chk_YearMonth();
}
