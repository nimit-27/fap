  {
    doQueryMode();
  }

  document.all.butInsert.disabled="true";
  document.all.butDelete.disabled="true"; 
  
  /*
    if(document.all.hdnEmpLbrFlag.value=='L')
    document.all.lstLabourType.value='DEP';
  else if(document.all.hdnEmpLbrFlag.value=='K')
    document.all.lstLabourType.value='KOT';
  else 
    document.all.lstLabourType.value='DPS';
  */  
  if(frmNWNPLbrHndlngAttndForm.screenModeID.value=='UG')
  {
      document.all.butGetDetail.disabled="true";
      document.all.butInsert.disabled="true";
      document.all.butDelete.disabled="true";
      var oTable = document.getElementById("Detail");
        if(oTable == null)
        {
          return;
        }  
      document.all.butExecute.disabled="true";    
      document.all.butExecute.src="../INCLUDES/IMAGES/execute_dis.jpg"; 
  }
   
  
  mode = frmNWNPLbrHndlngAttndForm.screenMode.value;  
  if(mode=='Q')
  {
     document.all.butGetDetail.disabled="true";
     document.all.butInsert.disabled="true";
     document.all.butDelete.disabled="true";     
  } 
  
    if(mode=='U')
    {    
        document.all.butInsertMode.disabled="true";    //
	document.all.butInsertMode.src="../INCLUDES/IMAGES/insert_dis.jpg";   //
        if(frmNWNPLbrHndlngAttndForm.screenModeID.value=='UI' )
        {
            document.all.butGetDetail.disabled="";
            document.all.butInsert.disabled="true";
            document.all.butDelete.disabled="true";
        }
        else
        {
          document.all.butGetDetail.disabled="true";
          document.all.butInsert.disabled="true";
          document.all.butDelete.disabled="true";          
        } 
        var  yearM = document.getElementById("txtYYMM").value;          
        var month =  yearM.substring(4,6);        
        var oTable = document.getElementById("Detail");        
        if(oTable == null)
        {
          return;
        }
        else
        {
            var iTr2 = oTable.rows.length;
            var i = 0;
            var fieldVal;
            if(frmNWNPLbrHndlngAttndForm.screenModeID.value =='UG')
            {
              var noDays = daysYearMonth(month, yearM.substring(0,4));
              for(i=0; i < iTr2 -2; i++)
              {   
                for (k = 1; k< noDays+1; k++)
                {
                  var firstDay = getDayofWeek(month, yearM.substring(0,4),k);
                  
                  if (firstDay ==0)
                  {
                    fieldVal="txtDays"+k; 
                    document.getElementsByName(fieldVal)[i].value="H";  
                  }
                  else
                  {
                    fieldVal="txtDays"+k;                    
                    document.getElementsByName(fieldVal)[i].value="W";
                  }
                  
                }
              }
            }  
            var ctrl;
            
            /*for(i=0; i < iTr2 -2; i++)
            {   
                for(j=noDays+1; j < 32; j++)    
                {                    
                    fieldVal="txtDays"+j;    
					alert ("days" + fieldVal);
                    document.getElementsByName(fieldVal)[i].value="";                             
                    document.getElementsByName(fieldVal)[i].disabled = "true";
                }
            }*/
        }
		disableAttnd();
		if(document.all.hdnEmpLbrFlag.value=='L')
		{
		disableleavedays();
		}
    } 
    
    var oTable = document.getElementById("Detail");
    if(oTable == null)
    {
      return;
    }
    var iTr2 = oTable.rows.length;
    var i = 0;
    for(i=0; i < iTr2 -2; i++)
    {
        calcPresentOnLoad(i+1);
    }  
  menuHandling(mode);
  document.all.butDel.disabled="true";    
  document.all.butDel.src="../INCLUDES/IMAGES/delete_dis.jpg";
}



function disableAttnd()
{
	var yearM = document.getElementById("txtYYMM").value;          
	var month =  yearM.substring(4,6);        
    var oTable = document.getElementById("Detail");
	var iTr2 = oTable.rows.length;
    if (oTable == null)
    {
      return;
    }
	else
	{
		var noDays = daysYearMonth(month, yearM.substring(0,4));
		for(i=0; i < iTr2 -2; i++)
		{   
			for(j=noDays+1; j < 32; j++)    
			{                    
				fieldVal="txtDays"+j;
				document.getElementsByName(fieldVal)[i].value="";                             
				document.getElementsByName(fieldVal)[i].disabled = "true";
			}
		}
	}
}

function showWeekDays()
{       
    var  yearM = document.getElementById("txtYYMM").value;          
    var uMonth =  yearM.substring(4,6);    
    var uYear =  yearM.substring(0,4);
    var monthIndex;
    
    var Months = new Array("January","February","March","April","May","June",
	                       "July","August","September","October","November","December");
    
    switch (parseInt(uMonth))
    {
      case 1:
              monthIndex = Months[0]; break;
      case 2:
              monthIndex = Months[1]; break;
      case 3: 
              monthIndex = Months[2]; break;
      case 4:
              monthIndex = Months[3]; break;
      case 5:
              monthIndex = Months[4]; break;
      case 6:
              monthIndex = Months[5]; break;
      case 7:
              monthIndex = Months[6]; break;
      case 8:
              monthIndex = Months[7]; break;
      case 9: 
              monthIndex = Months[8]; break;
      case 10:
              monthIndex = Months[9]; break;
      case 11:
              monthIndex = Months[10]; break;
      case 12:		
              monthIndex = Months[11]; break;
    };    
    var monthName=monthIndex+" 1";    
    var uDay=new Date(monthName + "," + uYear);  
    
    var iTr2 = oTable.rows.length;
    var i = 0;
    var noDays = daysYearMonth(month, yearM);
    
}

function daysYearMonth(mnth, years )
{
    var intMonth = mnth; //given month
    var intYear = years; //given year    
    
    if (1 == intMonth || 3 == intMonth || 5 == intMonth || 7 == intMonth || 8 == intMonth ||
    10 == intMonth || 12 == intMonth)
    {
        return 31;
    }
    else if (2 == intMonth)
    {
        // Check for leap year
        if (0 == (intYear % 4))
        {
            // If date is divisible by 400, it's a leap year.
            // Otherwise, if it's divisible by 100 it's not.
            if (0 == (intYear % 400))
            {     
               return 29;
            }
            else if (0 == (intYear % 100))
            {             
                return 28;
            }    
            // Divisible by 4 but not by 100 or 400
            // so it leaps 
            return 29;
        }
        // Not a leap year        
        return 28;
    }
    return 30;     
}

function getDayofWeek(mnth, years, wDay )
{
  var sDay = new Date(years,mnth-1,wDay);  
  var cDay = sDay.getDay();    
  //var weekday = new Array("S", "M", "T", "W", "T", "F", "S");
  //alert("You were born on a " + weekday[dayborn]);
  return cDay;
  
}

