<html:html>
    <HEAD>
    <html:base/>
    <TITLE><bean:message key="Payroll.title" /></TITLE>
    <jsp:include page = "../INCLUDES/GenIncludes.jsp" />
    
    <link rel="STYLESHEET" type="text/css" href="../../CSS/PayrollMenucss.css"></link>
    <script language="JavaScript1.2" src="../../../COMMON/JavaScript/Menu_func.js"></script>
    <script language="JavaScript1.2" src="../../../COMMON/JavaScript/Menu_addins.js"></script>
    <script language="javascript" src="../../../COMMON/JavaScript/validate.js"></script>
    <script language="JavaScript1.2" src="../INCLUDES/payrollToolBar.js"></script>  
   
</HEAD>    

<BODY  onload="lfnLoad();" onbeforeunload="confWindowClose()" onunload="handleOnClose()" oncontextmenu="return false">
<jsp:include page="../../../COMMON/JSP/menu.jsp" flush="true" />
<html:form  action="NWNPLbrAttndDetailBase" name="frmNWNPLbrHndlngAttndForm" type="FCIPAY.Payroll.Labour.WEBTIER.Form.NWNPMaintHndlngAttndForm" scope="session">
<bean:define id="ParentForm" name="frmNWNPLbrHndlngAttndForm" toScope="request" />
<jsp:include page = "../INCLUDES/GenIconMenu.jsp" />

<html:hidden property="detailDataChanged"  />
<html:hidden property="headerFields" value="false" />
<%! int i=0,j=0; %>
<% i = 0;j=0; %>
<%
    String empLbr = (String)(request.getSession().getAttribute("hdnEmpLbrFlag"));
%>
<html:errors/>
<table>
<TR height=30>
  <TD  colSpan=12 class=mainHeader height=10>MAINTAIN NWNP HANDLING LABOUR ATTENDANCE</TD>
</TR>
</TABLE>
<!--container table starts -->
<TABLE cellSpacing=0 cellPadding=0 border=0 >
<TBODY>
  <TR>
    <TD>
	
       <!--<div id=divBody>-->
       <!-- Body table Starts -->
       <TABLE cellSpacing=0 cellPadding=0 border=0>
       <!--Account  Header Row Starts -->
       <TR>
          <TD class=subHeader colspan=6>Attendance Header</TD>
        </TR>
        <TR>
              <TD colspan=6 bgColor=#4682b4><IMG height=1 src="../INCLUDES/IMAGES/pixel.gif" width=1 border=0></img></TD>
	      </TR>
         <tr height="15" >
            <td colspan="2"></td>
         </tr>
        
          <tr>
          <td class="labelText"  width="25%" ><bean:message key="Payroll.NWNPLabour.Loc" /></td>
          <td width="25%">                  
            <logic:equal property= "screenMode" name= "frmNWNPLbrHndlngAttndForm" value="U">                              
            <html:text  property="txtLocation" maxlength="20" size="23" titleKey="Payroll.NWNPLabour.Loc" styleClass="required" readonly="true"/>                  
            </logic:equal>                                                                                                 
            <logic:notEqual property= "screenMode" name= "frmNWNPLbrHndlngAttndForm" value="U">                              
            <html:text  property="txtLocation" maxlength="20" size="23" titleKey="Payroll.NWNPLabour.Loc" readonly="true" styleClass="required"  onchange="" />                  
            <img src="../INCLUDES/IMAGES/lov.jpg" height="16" align="center" name="buttxtSection" onclick="return ShowLovLocation();" readonly="true">
            </img></logic:notEqual>
           
          </td>

          <td class="labelText"  width="25%" ><bean:message key="Payroll.MaintDARates.year" /></td>
          <td>
          <logic:notEqual property= "screenMode" name= "frmNWNPLbrHndlngAttndForm" value="U">                              
          <html:text  property="txtYYMM" altKey="Payroll.MaintDARates.year" maxlength="6" size="23" titleKey="Payroll.MaintDARates.year" styleClass="required" onchange="chk_YearMonth(); " />
          <bean:message key="Payroll.MaintDARates.yymm" />
          </logic:notEqual>   
          <logic:equal property= "screenMode" name= "frmNWNPLbrHndlngAttndForm" value="U">                              
          <html:text  property="txtYYMM" altKey="Payroll.MaintDARates.year" maxlength="6" size="23" styleClass="required" readonly="true" onchange="chk_YearMonth();" />
          <bean:message key="Payroll.MaintDARates.yymm" />
          </logic:equal>
          </td>
          </tr>         
         
