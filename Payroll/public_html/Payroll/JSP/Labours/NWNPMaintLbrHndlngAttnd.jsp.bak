  <table cellspacing=0 cellpadding=0 border=0>
         <!-- Detail Information Row starts -->

 	 <TR height="200">
            <TD colspan=11>

            <!-- Account Config Detail Table Starts -->
           <TABLE cellspacing="0" cellPadding="0" >
              <TR>
                    <td bgcolor="#4682B4" width="10"><img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></img></td>
                    <td bgcolor="#4682B4" nowrap class=actTabText > Attendance Details <img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></img></td>
                    <td><img src="../INCLUDES/IMAGES/formtab_r.gif" width="10" height="21" border="0"></img></td>

                    <td background="../INCLUDES/IMAGES/line_t.gif" width="100%" style="color:#993300;font-size:8pt;text-align:right;font-weight:normal;font-family:'verdana, Arial, Helvetica, sans-serif'">
                    <%
                        if(empLbr != null)
                        {
                        if (empLbr.equals("N")) 
                        {
                    %>
                        A-Absent<font style="color:#2C2C2C;font-size:10pt">|</font>W-On Work|P -Present But No Work|H-Holiday|X-National Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>K-Work on Holiday
                    <%  
                        }else 
                    {%>
                        A-Absent<font style="color:#2C2C2C;font-size:10pt">|</font>F-Half Pay Leave<font style="color:#2C2C2C;font-size:10pt">|</font>M-Med Leave<font style="color:#2C2C2C;font-size:10pt">|</font>W-On Work<font style="color:#2C2C2C;font-size:10pt">|</font>H-Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>K-Work on Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>D-Attend Day<font style="color:#2C2C2C;font-size:10pt">|</font>V-Privilege Leave<font style="color:#2C2C2C;font-size:10pt">|</font>B-Booked On NonPaid Holiday<font style="color:#2C2C2C;font-size:10pt">|</font>C-Casual Leave<font style="color:#2C2C2C;font-size:10pt">|</font>|I-Disability Leave|T-Maternity Leave 
                    <% }} %>
		 </td>
                <td background="../INCLUDES/IMAGES/line_t.gif"><img src="../INCLUDES/IMAGES/pixel.gif" width="10" height="1" border="0"></img></td>
              </TR>
          
              <TR height=10>
                
		<!-- Detail table Container starts -->
                <TD colspan="8">
                  <TABLE cellSpacing="0" cellPadding="0" border="0" >
                    <TBODY>
                    <TR>
                      <TD >
                        <DIV id=divDtlTable style="height:400px">
  			<!-- Detail table starts -->
                        <TABLE cellSpacing="0" cellPadding="0" id="Detail" border=0>
                          <TBODY>
                          <tr width="100%">                            
                            <TD colspan="35" class=tableHeader width="2%"><bean:message  key="Payroll.Labour.Days" />
                            </TD>
                          </tr>        
                             
                          <TR>
                            <td class=tableHeader width = 1%></TD>
                            <td class=tableHeader width="1%"><bean:message key="Payroll.MaintDirect.srno" /></td>
                            <TD class=tableHeader width="1%"><bean:message  key="Payroll.Common.empNo" /></td>
                            <TD class=tableHeader width="13%"><bean:message  key="Payroll.Common.empName" /></td>
                            <%
                            if(empLbr.equals(new String("K"))) {%> 
                            <TD class=tableHeader width = 2%> Labour Code</td>
                            <%} else {  %>           
                            <TD class=tableHeader width = 2%></td> 
                            <%}  %>                            
                            
                             <% for (int m=0; m<31; m++)
                             { 
                             %>
                            <TD id="<%=m+1 %>" class=tableHeader width="2%"><%=m+1 %></TD>
                            
                            <% }
                            %>
                            <TD class=tableHeader width="2%">No of Present Days</td>
                          </TR>

                          <logic:iterate id="darate" name="frmNWNPLbrHndlngAttndForm" property="lstInstrDtls" type="FCIPAY.Payroll.Labour.Utility.NWNPLbrHndlngAttndBean" >
                            <% ++i; %>
                            <logic:notEqual name="darate" property="status" value="D" >                                                        
                            <tr><% ++j; %>                              
                            <td width = 1%></TD>
					 <!-- added by dushyant on 18-Jan-2012-->
                            <td ><html:text property="txtSrNo" name="frmNWNPLbrHndlngAttndForm" size="3"   value="<%=String.valueOf(i)%>" styleClass="locked" style="width:100%" alt="<%=String.valueOf(i)%>"  /></td>
					 <!-- added by dushyant on 18-Jan-2012-->
					 <!-- added by dushyant on 22-feb-2011-->
                            <td  width="2%" ><html:text property="txtEmpNo" name="darate" styleClass="locked" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" readonly="true" maxlength="9" onchange="" /></td> 
                    <!-- added by dushyant on 22-feb-2011-->

                              <td  width="13%" ><html:text property="txtEmpName" name="darate" styleClass="locked" readonly="true" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" maxlength="9" onchange="" /></td>                                                         
                              
                              <% if(empLbr.equals(new String("K"))) {%> 
                              <td width = 2% ><html:text property="txtLabourCode" name="darate" styleClass="locked" readonly="true" style="width:100%;text-align:left"  alt="<%=String.valueOf(i)%>" maxlength="9" onchange="" /></td>                         
                              <%} else {  %>           
                              <td><html:hidden  property="txtLabourCode" altKey="Payroll.Labour.LabourCode"  /></td>  
                              <%}  %>
                              
                              <td width = 1%>
                              <html:text property="txtDays1" name="darate" alt="<%=String.valueOf(i)%>" style="width:100%;text-align:center" maxlength="1" onclick="storeTempAttndType(this.value); this.value='';" onblur="upper(this.alt, '1');" onkeypress="return checkAttndType();" onchange="calcPresent(this.alt,this.value, '1'); lfnChange('1', this.alt);" />
                              <html:hidden property="dayModified1" name="darate"/>
                              </TD>
                             
