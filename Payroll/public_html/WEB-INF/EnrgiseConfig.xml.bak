  <FormName>FCIPAY.Payroll.Labour.WEBTIER.Form.CalcDeptIncentiveForm</FormName> 
    <EnrgiseQueryVO>FCIPAY.Payroll.DATAACCESSTIER.VO.DummyQueryVO</EnrgiseQueryVO> 
     <HeaderBD>FCIPAY.Payroll.Labour.BUSINESSTIER.BusinessDelegates.CalcDeptIncentiveBD</HeaderBD> 
      <HeaderBean>FCIPAY.Payroll.Labour.Utility.CalcDeptIncentiveHeaderBean</HeaderBean> 
      <HeaderSize>8</HeaderSize> 
      <DetailScreens>
           <DetailScreen>
              <DetailScreenName>CalcDeptIncentiveScreen</DetailScreenName> 
              <DetailArrayName>detailList</DetailArrayName> 
          		 <DetailBD>FCIPAY.Payroll.Labour.BUSINESSTIER.BusinessDelegates.CalcDeptIncentiveBD</DetailBD>
           </DetailScreen>
           <DetailScreen>
              <DetailScreenName>CalcDeptIncentiveParamScreen</DetailScreenName> 
              <DetailArrayName>detailList</DetailArrayName> 
          		 <DetailBD>FCIPAY.Payroll.Labour.BUSINESSTIER.BusinessDelegates.CalcDeptIncentiveBD</DetailBD>
           </DetailScreen>
     </DetailScreens>
</SingleForm>  

